{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>hasansezertasan/renovate-config"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  },
  "packageRules": [
    {
      "description": "Auto-merge green PEP 735 dev/test/lint/docs dependency groups",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "matchJsonata": ["managerData.depGroup in ['dev', 'test', 'lint', 'docs']"],
      "groupName": "dev dependencies",
      "automerge": true
    },
    {
      "description": "Auto-merge green uv-native dev dependencies",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["tool.uv.dev-dependencies"],
      "groupName": "dev dependencies",
      "automerge": true
    },
    {
      "description": "Group non-major runtime updates to reduce PR noise",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python dependencies (non-major)"
    },
    {
      "description": "Never auto-merge direct (runtime) dependencies - the owner merges these manually",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.dependencies"],
      "automerge": false
    }
  ]
}