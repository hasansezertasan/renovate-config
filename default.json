{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "labels": ["internal"],
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "schedule": ["before 4am on monday"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update rev pins for prek hooks (Renovate's built-in pre-commit manager only reads .pre-commit-config.yaml, not prek.toml)",
      "managerFilePatterns": ["/(^|/)prek\\.toml$/"],
      "matchStrings": [
        "repo\\s*=\\s*\"https://github\\.com/(?<depName>[^\"]+?)(?:\\.git)?\"\\s*\\n\\s*rev\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "description": "Label prek.toml hook updates clearly in commit/PR titles",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["prek.toml", "**/prek.toml"],
      "commitMessageTopic": "prek hook {{depName}}"
    },
    {
      "description": "Group all GitHub Action updates into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group prek hook updates into one PR",
      "matchManagers": ["pre-commit"],
      "groupName": "prek hooks"
    },
    {
      "description": "Group prek.toml hook updates into the same PR (file-restricted so unrelated repo-local regex managers never leak in)",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["prek.toml", "**/prek.toml"],
      "groupName": "prek hooks"
    }
  ]
}
